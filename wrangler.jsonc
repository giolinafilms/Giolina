{
  "name": "giolina",
  "main": "worker.js",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "previews": {},
  "keep_vars": true,
  "vars": {
    "GIOLINA_INDEXING_ENABLED": "true",
    "GIOLINA_ANALYTICS_ENABLED": "false"
  }
}
