{
  "name": "giolina-films",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "node scripts/build-wedding-collection.mjs && astro build",
    "preview": "astro preview --host 0.0.0.0",
    "check": "node scripts/check.mjs && node scripts/check-seo.mjs",
    "media:sanitize": "node scripts/sanitize-media.mjs",
    "check:admin": "node admin/scripts/build-assets.mjs --check && node --check admin/client.js && node --test admin/tests/*.test.mjs",
    "predev": "node scripts/build-wedding-collection.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "astro": "7.3.5",
    "jose": "^6.1.3",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "jsdom": "^30.1.2",
    "wrangler": "4.135.0"
  }
}
