{
  "name": "giolina-smugmug-diagnostic",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [],
  "observability": { "enabled": false },
  "vars": {
    "DIAGNOSTIC_ENABLED": "false",
    "AUTHORIZED_RUN_ID": "",
    "CREDENTIAL_APPLICATION_CONFIRMED": "false"
  },
  "durable_objects": {
    "bindings": [{ "name": "RUN_GATE", "class_name": "RunGate" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RunGate"] }]
}
