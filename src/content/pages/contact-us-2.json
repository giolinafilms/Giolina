  "content": "<div class=\"elementor elementor-1752\" data-elementor-id=\"1752\" data-elementor-post-type=\"page\" data-elementor-type=\"wp-page\">\n\n<section class=\"elementor-section elementor-top-section elementor-element elementor-element-6edffec7 elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-e-type=\"section\" data-element_type=\"section\" data-id=\"6edffec7\">\n<div class=\"elementor-container elementor-column-gap-default\">\n<div class=\"elementor-column elementor-col-50 elementor-top-column elementor-element elementor-element-1b648e4e\" data-e-type=\"column\" data-element_type=\"column\" data-id=\"1b648e4e\">\n<div class=\"elementor-widget-wrap elementor-element-populated\">\n<div class=\"elementor-element elementor-element-3b313e04 elementor-widget elementor-widget-heading\" data-e-type=\"widget\" data-element_type=\"widget\" data-id=\"3b313e04\" data-widget_type=\"heading.default\">\n<div class=\"elementor-widget-container\">\n<h1 class=\"elementor-heading-title elementor-size-default\">INQUIRE</h1> </div>\n</div>\n<div class=\"elementor-element elementor-element-5b1d695e elementor-widget elementor-widget-text-editor\" data-e-type=\"widget\" data-element_type=\"widget\" data-id=\"5b1d695e\" data-widget_type=\"text-editor.default\">\n<div class=\"elementor-widget-container\">\n<p>We’d love to hear from you! Please fill out the form below or send a note directly to info@giolina.co.</p>\n<p class=\"gl-contact-service-area\">Based in Staten Island, serving New York, New Jersey and surrounding areas.</p> </div>\n</div>\n<section class=\"elementor-section elementor-inner-section elementor-element elementor-element-1b3ec8a2 elementor-section-boxed elementor-section-height-default elementor-section-height-default\" data-e-type=\"section\" data-element_type=\"section\" data-id=\"1b3ec8a2\">\n<div class=\"elementor-container elementor-column-gap-default\">\n<div class=\"elementor-column elementor-col-100 elementor-