---
const { path = '/' } = Astro.props;
const links = [
 { label: 'Home', href: '/', paths: ['/', '/homepage-preview/'] },
 { label: 'Cinematography', href: '/portfolio-2/', paths: ['/portfolio-2/', '/video-portfolio/'] },
 { label: 'Photography', href: '/portfolio/', paths: ['/portfolio/', '/photography/', '/photography-portfolio/'] },
 { label: 'Sweet Sixteen', href: '/sweet-sixteen/', paths: ['/sweet-sixteen/'] },
 { label: 'Reviews', href: '/client-reviews/', paths: ['/client-reviews/', '/reviews/'] },
 { label: 'Experience', href: '/experience-2/', paths: ['/experience-2/'] },
 { label: 'About Us', href: '/about-us/', paths: ['/about-us/', '/about-us-2/'] },
 { label: 'Contact Us', href: '/contact-us-2/', paths: ['/contact-us-2/', '/contact-us/'] },
];
const socials = [
 { label: 'Instagram', href: 'https://www.instagram.com/GioLinaFilms', glyph: '\uf16d' },
 { label: 'Vimeo', href: 'https://vimeo.com/readytogoproductions', glyph: '\uf40a' },
 { label: 'Facebook', href: 'https://www.facebook.com/GioLinaFilms', glyph: '\uf39e' },
];
---
<header class="gl-site-header">
 <div class="gl-site-nav">
  <nav class="gl-site-nav-inner gl-site-desktop-nav" aria-label="Main navigation">
   {links.map(link => <a href={link.href} aria-current={link.paths.includes(path) ? 'page' : undefined}>{link.label}</a>)}
  </nav>
  <details class="gl-site-mobile-menu">
   <summary>Menu</summary>
   <nav aria-label="Mobile navigation">
    {links.map(link => <a href={link.href} aria-current={link.paths.includes(path) ? 'page' : undefined}>{link.label}</a>)}
   </nav>
  </details>
 </div>
 <div class="gl-site-masthead">
  <img src="/assets/e845a4337da29ba0.png" width="800" height="411" alt="GioLina — photography and cinematography" fetchpriority="high" />
  <p>Cinematic wedding filmmaking &amp; photography</p>
  <div class="gl-site-header-actions">
   <nav class="gl-site-social-icons" aria-label="Social media">
    {socials.map(social => <a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={social.label}><span class="gl-site-social-glyph" aria-hidden="true">{social.glyph}</span></a>)}
   </nav>
   <a class="gl-site-header-inquire" href="/contact-us-2/">Inquire about your day</a>
  </div>
 </div>
</header>
