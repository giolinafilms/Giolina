---
import pages from '../content/pages.mjs';
import WeddingCollection from '../components/WeddingCollection.astro';
import EventsNav from '../components/EventsNav.astro';
import SiteBreadcrumb from '../components/SiteBreadcrumb.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import RtgHeader from '../components/RtgHeader.astro';
import RtgFooter from '../components/RtgFooter.astro';
import {canonicalOrigin, analytics} from '../config/site.mjs';
import {videoCatalogSchema} from '../content/video-seo.mjs';
export function getStaticPaths() {
 return pages.map(page => ({params:{slug:page.path==='/'?undefined:page.path.replace(/^\/+|\/+$/g,'')},props:{page}}));
}
const {page}=Astro.props;
const isEvents = page.path.startsWith('/events/');
const isRtg = page.path === "/ready-to-go-productions/";
---
<!doctype html>
<html lang="en-US">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="robots" content="noindex, nofollow" />
<title>{page.title}</title>
<link rel="canonical" href={new URL(page.path,canonicalOrigin).href} />
<script type="application/json" id="gl-analytics-config" set:html={JSON.stringify(analytics)} />
{[...(page.schema ?? []), ...videoCatalogSchema(page)].map((schema)=><script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll("<","\\u003c")} />)}
{page.seo.map((tag)=><Fragment set:html={tag} />)}
{page.css.map((href)=><link rel="stylesheet" href={href} />)}
<link rel="stylesheet" href="/migration.css" />
<link rel="stylesheet" href="/site-header.css" />
<link rel="stylesheet" href="/portfolio-refresh.css" />
<link rel="stylesheet" href="/editorial-oct02.css" />
<link rel="stylesheet" href="/portfolio-editorial-refinement.css" />
{page.path === "/sweet-sixteen/" && <link rel="stylesheet" href="/sweet-sixteen-refinement.css" />}
{isRtg && <link rel="stylesheet" href="/rtg-production.css" />}
{!isRtg && page.path !== "/sweet-sixteen/" && <link rel="stylesheet" href="/brand-refinement.css" />}
<link rel="stylesheet" href="/accessibility.css" />
<link rel="stylesheet" href="/public-polish.css" />
{page.path === "/experience-2/" && <link rel="stylesheet" href="/tenor-test.css" />}
{isEvents && <link rel="stylesheet" href="/events-phase1.css" />}
</head>
<body class={page.bodyClass}>
<a class="migration-skip" href="#content">Skip to content</a>
{isRtg ? <RtgHeader /> : <SiteHeader path={page.path} />}
{isEvents && <EventsNav path={page.path} />}
<main id="content" tabindex="-1">
{!isEvents && page.breadcrumbs?.length && <SiteBreadcrumb items={page.breadcrumbs} tone={page.path === "/sweet-sixteen/" ? "blush" : "wedding"} />}
<Fragment set:html={page.content} />
{page.path === "/photography/wedding-collection/" && <WeddingCollection />}
</main>
{isRtg ? <RtgFooter /> : <SiteFooter />}
{!isRtg && !isEvents && <nav class="gl-mobile-cta" aria-label="Quick contact">
 <a href="tel:8663060308">Call</a>
 <a href="/contact-us-2/">Inquire</a>
</nav>}
{!isRtg && !isEvents && <script src="/mobile-cta.js" defer is:inline></script>}
<script src="/migration.js" is:inline></script>
<script src="/film-player.js" defer={page.path === "/portfolio-2/"} is:inline></script>
<script src="/scheduler-links.js" defer is:inline></script>
</body>
</html>
