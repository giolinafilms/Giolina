---
import pages from '../content/pages.mjs';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import RtgHeader from '../components/RtgHeader.astro';
import RtgFooter from '../components/RtgFooter.astro';
export function getStaticPaths() {
 return pages.map(page => ({params:{slug:page.path==='/'?undefined:page.path.replace(/^\/+|\/+$/g,'')},props:{page}}));
}
const {page}=Astro.props;
const isRtg = page.path === "/ready-to-go-productions/";
---
<!doctype html>
<html lang="en-US">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex, nofollow" />
<title>{page.title}</title>
<link rel="canonical" href={new URL(page.path,'https://giolinafilms.com').href} />
{(page.schema ?? []).map((schema)=><script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll("<","\\u003c")} />)}
{page.seo.map((tag)=><Fragment set:html={tag} />)}
{page.css.map((href)=><link rel="stylesheet" href={href} />)}
<link rel="stylesheet" href="/migration.css" />
<link rel="stylesheet" href="/site-header.css" />
<link rel="stylesheet" href="/portfolio-refresh.css" />
<link rel="stylesheet" href="/editorial-oct02.css" />
<link rel="stylesheet" href="/portfolio-editorial-refinement.css" />
{page.path === "/sweet-sixteen/" && <link rel="stylesheet" href="/sweet-sixteen-refinement.css" />}
{isRtg && <link rel="stylesheet" href="/rtg-production.css" />}
{!isRtg && page.path !== "/sweet-sixteen/" && <link rel="stylesheet" href="/brand-refinement.css" />}
</head>
<body class={page.bodyClass}>
<a class="migration-skip" href="#content">Skip to content</a>
{isRtg ? <RtgHeader /> : <SiteHeader path={page.path} />}
<main id="content"><Fragment set:html={page.content} /></main>
{isRtg ? <RtgFooter /> : <SiteFooter />}
<script src="/migration.js" is:inline></script>
<script src="/film-player.js" defer={page.path === "/portfolio-2/"} is:inline></script>
<script src="/scheduler-links.js" defer is:inline></script>
</body>
</html>
